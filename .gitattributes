# Unix scripts keep LF on every platform, or they break on Linux and macOS
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf

*.jar binary

# App assets go into the APK byte for byte. Keep them exactly as committed, so a build
# on Windows matches F-Droid's build on Linux (reproducible builds).
android/app/src/main/assets/** -text
