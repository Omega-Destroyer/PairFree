<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- JBL and QCY only (docs/DESIGN.md, Permissions): most JBL models are controlled over
         Bluetooth LE, and when their LE side does not answer on the paired address, PairFree looks
         for its advert; QCY's always need their advert, which names the model and the LE side.
         Asked for only when the user opens one of them; never used for location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- The status notification (docs/DESIGN.md, Notification): it shows the battery, and holds
         the earbuds' channel as a connected-device foreground service while it does. Android
         lets it start when the earbuds connect with PairFree closed only once the user has
         linked PairFree to them as their companion app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- Works with no network (docs/DESIGN.md). Strip it even if a library asks for it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Nothing leaves the phone except files the user exports: no cloud backup or device transfer. -->
    <application
        android:name=".PairFreeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- singleTask: a bug report shared from the notification reaches the running app,
             not a second copy that would open its own connection. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A bug report for the EQ capture (docs/DESIGN.md). Android shares one with its
                 screenshot, as several files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.bugreport" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <service
            android:name=".status.StatusService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Earbuds connecting or disconnecting. Only the system can send these protected
             broadcasts, so the receiver needs no permission of its own. -->
        <receiver
            android:name=".status.ConnectionReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
