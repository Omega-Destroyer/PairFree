{
  "_about": "Machine-readable command table for SoundPEATS earbuds. See docs/PROTOCOL.md. Hex strings are big-endian. Not yet confirmed on hardware unless a device report in data/reports says so.",
  "frame": {
    "sof": "FF",
    "version": "04",
    "flags": "00",
    "length": "one byte, payload length",
    "vendor_main": "000A",
    "vendor_eq": "001D",
    "reply_mask": "8000",
    "layout": [
      "sof",
      "version",
      "flags",
      "length",
      "vendor(2)",
      "command(2)",
      "payload"
    ]
  },
  "transports": {
    "spp": {
      "uuid": "00001101-0000-1000-8000-00805F9B34FB"
    },
    "ble": {
      "service": "00001100-D102-11E1-9B23-00025B00A5A5",
      "write": "00001101-D102-11E1-9B23-00025B00A5A5",
      "notify": "00001102-D102-11E1-9B23-00025B00A5A5",
      "note": "On Qualcomm models drop the first four frame bytes in both directions."
    }
  },
