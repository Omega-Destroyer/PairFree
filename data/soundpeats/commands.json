{
  "_about": "Machine-readable command table for SoundPEATS earbuds. See docs/soundpeats/PROTOCOL.md. Hex strings are big-endian. Commands whose note names SOUNDPEATS 2.5.3 come from that app (PeatsAudio's successor, same company); the rest from PeatsAudio 1.9.45. Not yet confirmed on hardware unless a device report in data/soundpeats/reports says so.",
  "frame": {
    "sof": "FF",
    "version": "04",
    "flags": "00",
    "length": "one byte, payload length",
    "vendor_main": "000A",
    "vendor_eq": "001D",
    "reply_mask": "8000",
    "layout": [
      "sof",
      "version",
      "flags",
      "length",
      "vendor(2)",
      "command(2)",
      "payload"
    ]
  },
  "transports": {
    "spp": {
      "uuid": "00001101-0000-1000-8000-00805F9B34FB"
    },
    "ble": {
      "service": "00001100-D102-11E1-9B23-00025B00A5A5",
      "write": "00001101-D102-11E1-9B23-00025B00A5A5",
      "notify": "00001102-D102-11E1-9B23-00025B00A5A5",
      "note": "On Qualcomm models drop the first four frame bytes in both directions."
    }
  },
  "commands": [
    {
      "id": "firmware_version",
      "get": "0309",
      "kind": "text",
      "note": "Reply: status byte, then ASCII CODE_x_VERSION. Field 0 is the firmware code."
    },
    {
      "id": "battery_left",
      "get": "0306",
      "kind": "percent"
    },
    {
      "id": "battery_right",
      "get": "0307",
      "kind": "percent"
    },
    {
      "id": "battery_case",
      "get": "0323",
      "kind": "percent"
    },
    {
      "id": "anc_mode",
      "feature_codes": [
        "FSN08",
        "FSN09",
        "FSN10",
        "FSN11",
        "FSN34"
      ],
      "get": "0310",
      "set": "0311",
      "kind": "enum",
      "values": {
        "0": "off",
        "1": "anc",
        "2": "transparency",
        "3": "adaptive",
        "4": "weak"
      }
    },
    {
      "id": "anc_level",
      "feature_codes": [
        "FS_ANC_LEVEL"
      ],
      "get": "0324",
      "set": "0325",
      "kind": "level_list",
      "values": {
        "1": "level_1",
        "2": "level_2",
        "3": "level_3",
        "4": "level_4",
        "5": "level_5",
        "17": "normal",
        "18": "indoor",
        "19": "outdoor",
        "20": "traffic",
        "21": "adaptive",
        "22": "anti_wind"
      }
    },
    {
      "id": "transparency_level",
      "feature_codes": [
        "FS_TRANSPARENT_LEVEL"
      ],
      "get": "034C",
      "set": "034D",
      "kind": "level_list",
      "values": {
        "1": "voice_enhance",
        "2": "standard"
      }
    },
    {
      "id": "anc_env_adaptive",
      "get": "0364",
      "set": "0365",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      }
    },
    {
      "id": "game_mode",
      "feature_codes": [
        "FSN04"
      ],
      "get": "030E",
      "set": "030F",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      }
    },
    {
      "id": "multipoint",
      "feature_codes": [
        "FSN01"
      ],
      "get": "0314",
      "set": "0315",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      }
    },
    {
      "id": "ldac",
      "feature_codes": [
        "FSN25"
      ],
      "get": "0338",
      "set": "0339",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      }
    },
    {
      "id": "le_audio",
      "feature_codes": [
        "FSN24"
      ],
      "get": "0335",
      "set": "0334",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      },
      "per_model": true,
      "note": "Changing it restarts the earbuds, which reconnect by themselves (Air5 Pro+). The H3 answers the read but PeatsAudio does not offer it, so it is offered only on models whose devices.json entry lists it under confirmed."
    },
    {
      "id": "in_ear_detection",
      "feature_codes": [
        "FSN03"
      ],
      "get": "030C",
      "set": "030D",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      }
    },
    {
      "id": "touch_disabled",
