      "values": {
        "0": "stop",
        "1": "beep"
      }
    },
    {
      "id": "find_right",
      "feature_codes": [
        "FSN18-R"
      ],
      "get": "034B",
      "set": "033B",
      "kind": "switch",
      "values": {
        "0": "stop",
        "1": "beep"
      }
    },
    {
      "id": "reset_state",
      "get": "0367",
      "set": "0368",
      "kind": "raw",
      "note": "Reply: last two bytes equal 1 means the earbuds were just factory reset."
    },
    {
      "id": "connect_classic",
      "get": "0317",
      "kind": "raw",
      "probe": false,
      "note": "Defined in the app's command enum with reply 8317 and never sent by it. The name suggests it asks the earbuds to connect classic Bluetooth, so it may not be a harmless read. Do not probe."
    },
    {
      "id": "spatial_audio_mode",
      "set": "0359",
      "kind": "raw",
      "note": "One byte."
    },
    {
      "id": "dolby_mode",
      "set": "0354",
      "kind": "raw",
      "note": "One byte."
    },
    {
      "id": "dolby_supported_hint",
      "set": "0362",
      "kind": "raw",
      "probe": false,
      "note": "One byte: 00 if the phone supports Dolby, 01 if not. The app sends it only to firmware code S7 (Clip1), after reading the device state."
    },
    {
      "id": "fit_test",
      "set": "0363",
      "kind": "raw",
      "note": "Start or stop. Result arrives as 8363. Non-Qualcomm models; the payloads are not known. Qualcomm models use GAIA v3 instead: see gaia below. Reached from the fit-inspection screen (app feature FSN17)."
    },
    {
      "id": "reset_custom_keys",
      "set": "03AC",
      "kind": "action"
    },
    {
      "id": "earbud_color",
      "get": "0326",
      "kind": "raw",
      "note": "From SOUNDPEATS 2.5.3. Reply: the leading byte, then one byte for the colour of this pair; the app shows the matching product picture."
    },
    {
      "id": "le_audio_broadcast",
      "get": "0337",
      "set": "0336",
      "kind": "raw",
      "probe": false,
      "note": "From SOUNDPEATS 2.5.3, which names these two but never sends them, so their values are not known."
    },
    {
      "id": "hearing_protection",
      "get": "034E",
      "set": "034F",
      "kind": "percent",
      "note": "From SOUNDPEATS 2.5.3: a volume limit. The app sends one byte and accepts replies from 50 to 100."
    },
    {
      "id": "volume_balance",
      "get": "0375",
      "set": "0376",
      "kind": "percent",
      "note": "From SOUNDPEATS 2.5.3: left/right volume balance, one byte from 0 to 100."
    },
    {
      "id": "phone_codec",
      "get": "0377",
      "kind": "enum",
      "values": {
        "0": "other",
        "4": "ldac",
        "9": "opus"
      },
      "note": "From SOUNDPEATS 2.5.3: the codec the earbuds are playing. The app accepts 0 to 9 and names only these three. See docs/soundpeats/PROTOCOL.md section 12."
    },
    {
      "id": "device_history",
      "get": "0352",
      "kind": "raw",
      "probe": false,
      "note": "From SOUNDPEATS 2.5.3: the phones these earbuds have connected to. Reply: an entry number, 1 if that phone is connected now, its Bluetooth address (6 bytes), then its name ending in a 0 byte. On S13 a 41-byte reply has one extra leading byte. It holds other people's device names and addresses: never read it unasked and never put it in a report."
    },
    {
      "id": "device_connection",
      "set": "0353",
      "kind": "raw",
      "note": "From SOUNDPEATS 2.5.3: connect or disconnect one of the phones in device_history. Payload: its Bluetooth address (6 bytes), then 1 to connect or 0 to disconnect."
    },
    {
      "id": "send_device_address",
      "set": "0351",
      "kind": "raw",
      "note": "From SOUNDPEATS 2.5.3, which names it but never sends it."
    },
    {
      "id": "auracast",
      "set": "0378",
      "kind": "raw",
      "note": "From SOUNDPEATS 2.5.3: Auracast broadcast control; the earbuds answer with 8378. The payload starts with a sub-command (1 scan, 2 join a source, 4 listening control, 5 listening state) and carries fields tagged by type (1 name, 2 broadcast id, 3 features, 4 address, 5 listening state, 6 broadcast code). The exact layout was not traced."
    },
    {
      "id": "reboot",
      "set": "0316",
      "kind": "action",
      "note": "Dangerous: confirm with the user first."
    },
    {
      "id": "factory_reset",
      "set": "0305",
      "kind": "action",
      "note": "Dangerous: confirm with the user first."
    }
  ],
  "gaia": {
    "_about": "Qualcomm GAIA v3 on vendor 001D, as PeatsAudio uses it on the H3 (docs/soundpeats/PROTOCOL.md section 11). A command number is feature (7 bits), packet type (2 bits: 0 command, 1 notification, 2 response, 3 error) and command (7 bits). Send only to models in the QUALCOMM family.",
    "vendor": "001D",
    "response": "0100",
    "get_features": "0001",
    "register_notification": "0007",
    "fit_feature": "09",
    "fit_start": "1200",
    "fit_start_payload": "01",
    "fit_result": "1280",
    "fit_results": {
      "1": "good",
      "2": "not_fit"
    }
  },
  "custom_keys": {
    "gestures": {
      "1": "tap_left",
      "2": "tap_right",
      "3": "double_left",
      "4": "double_right",
      "5": "triple_left",
      "6": "triple_right",
      "7": "hold_left",
      "8": "hold_right"
    },
    "actions": {
      "0": "none",
      "1": "volume_up",
      "2": "volume_down",
      "3": "play_pause",
      "4": "game_mode",
      "5": "previous",
      "6": "next",
      "7": "anc_cycle",
      "8": "voice_assistant"
    }
  },
  "eq": {
    "vendor": "001D",
    "command_qualcomm": "0E01",
    "command_other": "0E02",
    "band_payload_0E01": [
      "(count<<4)|index",
      "master_gain_db*60 (s16)",
      "freq_hz*3 (u16)",
      "gain_db*60 (s16)",
      "q*4096 (u16)"
    ],
    "band_payload_0E02": [
      "count",
      "index",
      "master_gain_db*60 (s16)",
      "freq_hz*3 (u16)",
      "gain_db*60 (s16)",
      "q*4096 (u16)"
    ],
    "index_base": 1,
    "custom_bands_hz": [
      31,
      62,
      125,
      250,
      500,
      1000,
      2000,
      4000,
      8000,
      16000
    ],
    "custom_bands_hz_bluetrum": [
      62,
      125,
      250,
      500,
      1000,
      2000,
      4000,
      8000
    ],
    "custom_band_q": 1.8,
    "command_rule": "0E01 if the family is QUALCOMM, or the model's old_eq_protocol flag is true, or the code is BS519W2D on firmware 0.4.5 or lower. Otherwise 0E02. data/soundpeats/devices.json has the result per model as eq_command.",
    "merge_rule": "onto_classic_bands if the family is QUALCOMM or the firmware code is in merge_onto_classic_codes. Otherwise append_after_classic. See docs/soundpeats/PROTOCOL.md section 4.",
    "merge_onto_classic_codes": [
      "SPTS04",
      "QCYTS04",
      "TS03WINGS2",
      "ZKLXSPACEPRO",
      "ZKLXAIR5LITE",
      "S13",
      "S15",
      "S22",
      "S29"
    ]
  }
}