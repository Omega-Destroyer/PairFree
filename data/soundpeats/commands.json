        "FSN02"
      ],
      "get": "0312",
      "set": "0313",
      "kind": "switch",
      "values": {
        "0": "off",
        "1": "on"
      }
    },
    {
      "id": "custom_keys",
      "feature_codes": [
        "FSN05"
      ],
      "get": "03AA",
      "set": "03AB",
      "kind": "key_map",
      "note": "Set payload: gesture, action. Reply: status, then gesture/action pairs."
    },
    {
      "id": "prompt_volume",
      "feature_codes": [
        "FSN15"
      ],
